# D Company ERP — copy to .env and edit. Never commit a real .env.

ENV=dev
APP_VERSION=dev
APP_REVISION=local
LOG_LEVEL=INFO
LOG_FORMAT=json
API_PREFIX=/api/v1
EXPOSE_DOCS=true

# Database
DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5432/erp
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — in production use RS256 + secrets manager
JWT_SECRET=please-rotate-me-please-rotate-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Native release compatibility. v5 remains the minimum client compatible with
# the conflict-safe Gaming write contract; v6 is the next release candidate.
# Do not advertise v6 until its signed artifact passes the final release gates.
ANDROID_MIN_SUPPORTED_VERSION_CODE=5
ANDROID_LATEST_VERSION_CODE=6
ANDROID_UPDATE_URL=
IOS_MIN_SUPPORTED_VERSION_CODE=1
IOS_LATEST_VERSION_CODE=1
IOS_UPDATE_URL=
CLIENT_UPDATE_MESSAGE=
REQUIRE_NATIVE_VERSION_HEADERS=true

# Account security approval. New logins and every password reset send a
# single-use code to this central mailbox.
ACCOUNT_SECURITY_EMAIL=business@retrocafe.online
ACCOUNT_SECURITY_COMPANY_ID=
ACCOUNT_OTP_TTL_MINUTES=10
ACCOUNT_OTP_MAX_ATTEMPTS=5
ACCOUNT_OTP_REQUEST_LIMIT=3

# Shared Tables/Gaming order checkout lease (30-600 seconds).
CHECKOUT_CLAIM_TTL_SECONDS=600

# SMTP (Zoho example for the D Company security mailbox)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=business@retrocafe.online
SMTP_PASSWORD=
FROM_EMAIL=business@retrocafe.online
FROM_NAME=D Company ERP
REPORT_RECIPIENT_EMAILS=
ALERT_RECIPIENT_EMAILS=business@retrocafe.online

# Host runtime monitor thresholds (production VM only)
PUBLIC_URL=https://dcompany.duckdns.org
MONITOR_HTTP_TIMEOUT_SECONDS=10
MONITOR_MAX_RESPONSE_MS=2500
MONITOR_DISK_WARNING_PERCENT=85
MONITOR_MEMORY_WARNING_PERCENT=10
BACKUP_MAX_AGE_HOURS=30

# Object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_UPLOADS=erp-uploads
S3_ACCESS_KEY=erp
S3_SECRET_KEY=erp_change_me

# OCR
OCR_PROVIDER=tesseract
OCR_CONFIDENCE_THRESHOLD=0.75

# Localization
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# CORS
CORS_ORIGINS=["http://localhost:5173"]
