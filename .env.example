# D Company ERP — LOCAL DEVELOPMENT ONLY. Never commit a real .env.
# This file contains intentionally weak/dev values and must be used only with
# the localhost-bound docker-compose.yml sandbox. It is not a production
# template. Production uses .env.production.example plus the validated,
# secret-generating install-on-vm.sh workflow; never copy these values there.

ENV=dev
APP_VERSION=dev
APP_REVISION=local
LOG_LEVEL=INFO
LOG_FORMAT=json
API_PREFIX=/api/v1
EXPOSE_DOCS=true

# Database
DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5432/erp
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
CLIENT_HEARTBEAT_USER_LIMIT_PER_MINUTE=30

# Remote-assistance tablet pairing. Development-only value; use a dedicated,
# unrelated secret of at least 32 random bytes in staging/production.
REMOTE_ASSISTANCE_PAIRING_SECRET=CHANGE_ME_dev_remote_pairing_secret_32_chars
# Development-only AES-256-GCM key (base64 for 32 zero bytes). Generate a
# dedicated random key for staging/production; never reuse pairing/JWT values.
REMOTE_ASSISTANCE_RELAY_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# JWT — in production use RS256 + secrets manager
JWT_SECRET=please-rotate-me-please-rotate-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Native release compatibility. v8 is the first client compatible with
# terminal purposes and the explicit Gaming Area -> Cafe POS handoff.
# Do not advertise v8 until its signed artifact passes the final release gates.
ANDROID_MIN_SUPPORTED_VERSION_CODE=8
ANDROID_LATEST_VERSION_CODE=8
CLIENT_COMPATIBILITY_POLICY_REVISION=1
ANDROID_UPDATE_ALLOWED_ORIGIN=http://localhost:5173
# Global release registry access is deny-all when blank. Configure only exact
# immutable company:user UUID pairs; this is separate from role permissions.
ANDROID_RELEASE_CONTROLLER_BINDINGS=
ANDROID_UPDATE_URL=
ANDROID_LATEST_VERSION_NAME=
ANDROID_UPDATE_RELEASE_NOTES=
ANDROID_UPDATE_APK_SHA256=
ANDROID_UPDATE_APK_SIZE_BYTES=
ANDROID_UPDATE_SIGNING_CERT_SHA256=
IOS_MIN_SUPPORTED_VERSION_CODE=1
IOS_LATEST_VERSION_CODE=1
IOS_UPDATE_URL=
CLIENT_UPDATE_MESSAGE=
REQUIRE_NATIVE_VERSION_HEADERS=true

# Account security approval. New logins and every password reset send a
# single-use code to this central mailbox.
SEED_OWNER_EMAIL=owner@dcompany.local
ACCOUNT_SECURITY_EMAIL=security@example.test
ACCOUNT_SECURITY_COMPANY_ID=
ACCOUNT_OTP_TTL_MINUTES=10
ACCOUNT_OTP_MAX_ATTEMPTS=5
ACCOUNT_OTP_REQUEST_LIMIT=3

# Shared Tables/Gaming order checkout lease (30-600 seconds).
CHECKOUT_CLAIM_TTL_SECONDS=600

# SMTP is intentionally unset in the localhost sandbox.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=security@example.test
FROM_NAME=D Company ERP
REPORT_RECIPIENT_EMAILS=
ALERT_RECIPIENT_EMAILS=

# Host runtime monitor thresholds (production VM only)
PUBLIC_URL=http://localhost:5173
MONITOR_HTTP_TIMEOUT_SECONDS=10
MONITOR_MAX_RESPONSE_MS=2500
MONITOR_DISK_WARNING_PERCENT=85
MONITOR_MEMORY_WARNING_PERCENT=10
BACKUP_MAX_AGE_HOURS=30

# Object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_UPLOADS=erp-uploads
S3_ACCESS_KEY=erp
S3_SECRET_KEY=erp_change_me

# OCR
OCR_PROVIDER=tesseract
OCR_CONFIDENCE_THRESHOLD=0.75

# Localization
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# CORS
CORS_ORIGINS=["http://localhost:5173"]
