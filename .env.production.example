# D Company ERP — Production environment.
# Copy this file to .env on the production VM and replace EVERY value
# marked CHANGE_ME. The deploy script (infra/scripts/install-on-vm.sh)
# will generate strong random secrets for you the first time it runs.

# ----- runtime -----
ENV=prod
APP_VERSION=3.1.12
# Set to the exact clean release commit before building production images.
APP_REVISION=CHANGE_ME_git_commit_sha
LOG_LEVEL=INFO
LOG_FORMAT=json
API_PREFIX=/api/v1
EXPOSE_DOCS=false      # never expose /docs publicly in prod

# ----- the domain you bought -----
# Used by Caddy for HTTPS, CORS, and link-building in receipts.
DOMAIN=CHANGE_ME.com

# ----- database -----
# Strong password generated by the install script; rotate annually.
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
DATABASE_URL=postgresql+psycopg://erp:CHANGE_ME_strong_random_password@postgres:5432/erp
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ----- redis -----
# Dedicated Redis ACL password. Keep this hex-safe because Compose constructs
# redis://erp_backend:<password>@redis:6379/0 for the backend.
# Generate independently with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_64_hex_redis_password
# Authenticated native telemetry is keyed by company+user, never client UUID.
CLIENT_HEARTBEAT_USER_LIMIT_PER_MINUTE=30
# Dedicated remote-assistance pairing secret. Do not reuse JWT_SECRET.
# Generate independently with: openssl rand -base64 48
# Rotation changes every outstanding tablet pairing code; active approved keys
# remain valid, while pending tablets must refresh status to display a new code.
REMOTE_ASSISTANCE_PAIRING_SECRET=CHANGE_ME_48_char_dedicated_pairing_secret
# Dedicated 32-byte AES-256-GCM key for ephemeral relay frames. Standard
# base64 including padding; never reuse JWT/pairing/Redis credentials.
# Generate independently with: openssl rand -base64 32 | tr -d '\n'
# Rotation makes only the latest <=10-second frame unreadable; clients upload
# a fresh frame after the backend restarts.
REMOTE_ASSISTANCE_RELAY_SECRET=CHANGE_ME_32_byte_base64_relay_key

# ----- JWT (auth) -----
# Generate with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_48_char_base64_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Code 8 remains the compatibility floor and the safe rollout default. The
# signed 3.1.3/code-14 APK is the manual partner baseline, not an advertised
# update. Codes 15 through 21 remain immutable release history; code 22 is an
# unsigned superseded candidate. Code 23 is the separately gated server-delivery
# candidate; this example does not advertise, stage, or activate it. The
# compatibility defaults therefore remain unchanged.
ANDROID_MIN_SUPPORTED_VERSION_CODE=8
ANDROID_LATEST_VERSION_CODE=8
# Monotonic. Increment for every minimum-policy change, including rollbacks.
CLIENT_COMPATIBILITY_POLICY_REVISION=1
# Stable SSRF boundary for owner-activated DB releases. This is an origin only;
# APK URLs must still use /downloads/android/<safe>.apk on this origin.
ANDROID_UPDATE_ALLOWED_ORIGIN=https://CHANGE_ME.com
# Comma-separated <company-uuid>:<user-uuid> bindings. Leave blank to disable
# every release-list/activate/withdraw control (the fail-closed default).
ANDROID_RELEASE_CONTROLLER_BINDINGS=
ANDROID_UPDATE_URL=
# These legacy environment artifact fields are reserved for required-update
# recovery when the minimum is deliberately raised. Optional direct releases
# are staged from the CI manifest and activated by the explicitly bound owner.
ANDROID_LATEST_VERSION_NAME=
ANDROID_UPDATE_RELEASE_NOTES=
ANDROID_UPDATE_APK_SHA256=
ANDROID_UPDATE_APK_SIZE_BYTES=
ANDROID_UPDATE_SIGNING_CERT_SHA256=
IOS_MIN_SUPPORTED_VERSION_CODE=1
IOS_LATEST_VERSION_CODE=1
IOS_UPDATE_URL=
CLIENT_UPDATE_MESSAGE=
# Required for this release so pre-header native clients cannot bypass the
# compatibility gate and fail later inside a financial write.
REQUIRE_NATIVE_VERSION_HEADERS=true

# ----- CORS -----
# Lock to your real domain. Add Capacitor origins when shipping the iOS/iPadOS app.
# (DuckDNS subdomains do NOT support a www variant — keep just the bare one.)
CORS_ORIGINS=["https://CHANGE_ME.com","https://localhost","capacitor://localhost","ionic://localhost"]

# ----- object storage (OCR uploads) -----
# Leave the MinIO defaults if you're running it on the VM.
# If you switch to S3/R2 later, update these values.
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_UPLOADS=erp-uploads
S3_ACCESS_KEY=erp
S3_SECRET_KEY=CHANGE_ME_minio_password

# ----- localization -----
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# ----- owner security, email reports, and operational alerts -----
PUBLIC_URL=https://CHANGE_ME.com
ACCOUNT_SECURITY_EMAIL=owner@CHANGE_ME.com
ACCOUNT_SECURITY_COMPANY_ID=
REPORT_RECIPIENT_EMAILS=owner@CHANGE_ME.com
ALERT_RECIPIENT_EMAILS=owner@CHANGE_ME.com
# Port 465 uses implicit TLS; port 587 uses mandatory STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASSWORD=CHANGE_ME_smtp_password
FROM_EMAIL=owner@CHANGE_ME.com
FROM_NAME=D Company ERP

# ----- off-site backup credentials (Backblaze B2 restricted app key) -----
B2_KEY_ID=CHANGE_ME_b2_key_id
B2_APPLICATION_KEY=CHANGE_ME_b2_application_key

# ----- host runtime monitor thresholds -----
MONITOR_HTTP_TIMEOUT_SECONDS=10
MONITOR_MAX_RESPONSE_MS=2500
MONITOR_DISK_WARNING_PERCENT=85
MONITOR_MEMORY_WARNING_PERCENT=10
BACKUP_MAX_AGE_HOURS=30

# ----- seed data (deploy-time) -----
# Owner login created by the seed script. CHANGE THE PASSWORD IMMEDIATELY
# after your first login.
SEED_OWNER_EMAIL=owner@CHANGE_ME.com
SEED_OWNER_PASSWORD=CHANGE_ME_strong_owner_password
