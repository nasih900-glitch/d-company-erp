<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The complete API26-compatible System launch surface. Higher API themes
         inherit these attributes so the palette and status-bar behavior stay equal. -->
    <style name="Base.Theme.DCompany" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brandBackground</item>
        <item name="android:statusBarColor">@color/brandBackground</item>
        <item name="android:navigationBarColor">@color/brandBackground</item>
        <item name="android:windowLightStatusBar">@bool/lightSystemBars</item>
    </style>
    <style name="Theme.DCompany" parent="Base.Theme.DCompany" />
</resources>
