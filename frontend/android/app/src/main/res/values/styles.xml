<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme.
         Deliberately a *dark* parent: this is a near-black POS UI, and the
         generated default (Theme.AppCompat.Light) put a white status bar and
         a white window background behind it. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/brandBackground</item>
        <item name="android:statusBarColor">@color/brandBackground</item>
        <item name="android:navigationBarColor">@color/brandBackground</item>
        <!-- false = light icons, which is what a dark bar needs. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/brandBackground</item>
        <item name="android:statusBarColor">@color/brandBackground</item>
        <item name="android:navigationBarColor">@color/brandBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Launch/splash theme. The status bar attributes are repeated here on
         purpose: this is the theme MainActivity actually starts with, so
         without them the very first frame flashes a white bar before the
         WebView paints. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/brandBackground</item>
        <item name="android:navigationBarColor">@color/brandBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
