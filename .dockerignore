.git
.gitignore
.DS_Store
**/.DS_Store

# Local secrets and machine-specific config. Keep examples tracked, never real envs.
.env
.env.*
!.env.example
!.env.production.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Signing material and third-party service credentials are Git-ignored but can
# still exist locally. Docker build context filtering must protect them too:
# a clean Git checkout alone says nothing about untracked ignored files.
**/*.key
**/*.pem
**/*.p12
**/*.p8
**/*.jks
**/*.keystore
**/keystore.properties
**/google-services.json
**/GoogleService-Info.plist

# Local databases, backups and operational evidence never belong in an image
# layer, even when they happen to sit below backend/ or frontend/.
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.dump
**/pgdata
**/miniodata
**/backups
**/secrets
**/release-artifacts
**/releases/android/*
!**/releases/android/README.md
**/*.log
**/*.pid
.codex

# Dependency and build output that should never be sent to Docker build context.
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
frontend/dist
frontend/demo-dist*
frontend/live-dist
frontend/coverage
# Native clients are not inputs to either production Docker image. Excluding
# their source and generated schema history keeps deploy contexts small and
# prevents unrelated mobile files from invalidating backend/web build caches.
android-native
frontend/android
frontend/ios
frontend/src-tauri
frontend/ios/App/build
frontend/ios/App/DerivedData
frontend/ios/App/Pods
frontend/ios/App/App.xcworkspace
frontend/ios/App/*.xcarchive

# Local distribution artifacts and screenshots.
*.zip
*.ipa
*.dmg
*.pkg
*.msi
*.exe
*.xcarchive
AppStore_Screenshots*
Simulator Screen*
simulator_screenshot_*.png

# Internal handoff/legal docs are not needed inside production images.
HANDOFF.md
PROJECT_STATE.md
D_Company_Legal_Documents_Checklist*.docx
COMPANY_COMPLIANCE_CHECKLIST.md
LEGAL_DOCUMENTS_CHECKLIST.md
docs
download
preview-app
